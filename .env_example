#.env 파일 생성 후 아래와 같이 입력
PORT=3000

# 카카오 OAuth 설정
REACT_APP_KAKAO_CLIENT_ID=your_kakao_client_id
REACT_APP_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 쿠폰 서비스 (기본: coupon-service 직접. 게이트웨이 사용 가능)
REACT_APP_COUPON_API_BASE_URL=http://localhost:8087

# 주문·결제 (order-service / payment-service 직접)
REACT_APP_ORDER_API_BASE_URL=http://localhost:8085
REACT_APP_PAYMENT_API_BASE_URL=http://localhost:8088

# 토스페이먼츠 클라이언트 키(공개 키만; 시크릿은 백엔드)
REACT_APP_TOSS_CLIENT_KEY=example