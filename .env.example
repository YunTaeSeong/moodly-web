# =============================================================================
# Moodly Web 환경 변수 템플릿
# 사용법: cp .env.example .env 후 값 수정 → npm start (재시작 필요)
# =============================================================================

PORT=3000

# -----------------------------------------------------------------------------
# 카카오 OAuth (필수: 카카오 로그인 사용 시)
# 백엔드 auth-service KAKAO_* 와 동일한 앱·Redirect URI 사용
# -----------------------------------------------------------------------------
REACT_APP_KAKAO_CLIENT_ID=your_kakao_rest_api_key
REACT_APP_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# -----------------------------------------------------------------------------
# 토스페이먼츠 클라이언트 키 (공개 키만 — 시크릿은 moodly-api payment-service)
# -----------------------------------------------------------------------------
REACT_APP_TOSS_CLIENT_KEY=test_ck_your_toss_client_key

# -----------------------------------------------------------------------------
# API Base URL
# 미설정 시 각 서비스 직접 호출 (8081~8088). Gateway 사용 시 아래 주석 해제.
# -----------------------------------------------------------------------------

# --- [A] 서비스 직접 모드 (기본, 로컬 디버깅) ---
# REACT_APP_AUTH_API_BASE_URL=http://localhost:8081
# REACT_APP_API_BASE_URL=http://localhost:8082
# REACT_APP_PRODUCT_API_BASE_URL=http://localhost:8083
# REACT_APP_CART_API_BASE_URL=http://localhost:8084
# REACT_APP_ORDER_API_BASE_URL=http://localhost:8085
# REACT_APP_NOTIFICATION_API_BASE_URL=http://localhost:8086
# REACT_APP_COUPON_API_BASE_URL=http://localhost:8087
# REACT_APP_PAYMENT_API_BASE_URL=http://localhost:8088

# --- [B] Gateway 모드 (docker compose --profile app) ---
# cp .env.docker .env 후 값 채우기, 또는: npm install && npm run start:docker
# REACT_APP_AUTH_API_BASE_URL=http://localhost:8072/AUTH-SERVICE
# REACT_APP_API_BASE_URL=http://localhost:8072/USER-SERVICE
# REACT_APP_PRODUCT_API_BASE_URL=http://localhost:8072/PRODUCT-SERVICE
# REACT_APP_CART_API_BASE_URL=http://localhost:8072/CART-SERVICE
# REACT_APP_ORDER_API_BASE_URL=http://localhost:8072/ORDER-SERVICE
# REACT_APP_NOTIFICATION_API_BASE_URL=http://localhost:8072/NOTIFICATION-SERVICE
# REACT_APP_COUPON_API_BASE_URL=http://localhost:8072/COUPON-SERVICE
# REACT_APP_PAYMENT_API_BASE_URL=http://localhost:8072/PAYMENT-SERVICE
